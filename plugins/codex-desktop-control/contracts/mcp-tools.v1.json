{
  "contractVersion": "1.4.0",
  "serverName": "desktop-control",
  "toolPrefix": "desktop.",
  "coordinateSpace": "physical-virtual-desktop-pixels",
  "tools": [
    {
      "name": "desktop.observe",
      "classification": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "desktop"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "monitor"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "window"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "rect", "within"],
                "properties": {
                  "kind": { "const": "region" },
                  "rect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y", "width", "height"],
                    "properties": {
                      "x": { "type": "integer" },
                      "y": { "type": "integer" },
                      "width": { "type": "integer", "minimum": 1 },
                      "height": { "type": "integer", "minimum": 1 }
                    }
                  },
                  "within": {
                    "oneOf": [
                      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "desktop" } } },
                      { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "monitor" }, "id": { "type": "string", "minLength": 1, "maxLength": 200 } } },
                      { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "window" }, "id": { "type": "string", "minLength": 1, "maxLength": 200 } } }
                    ]
                  }
                }
              }
            ]
          },
          "includeCursor": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "description": "Capture current desktop, monitor, or authorized window pixels and synchronized physical-coordinate metadata.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
