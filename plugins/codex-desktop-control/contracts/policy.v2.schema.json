{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Desktop Control Policy V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observation", "control", "applications", "security", "logging", "emergencyStop"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowFullDesktop", "allowMonitors"],
      "properties": {
        "allowFullDesktop": { "type": "boolean" },
        "allowMonitors": { "type": "boolean" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialStopped", "maxActionsPerSecond"],
      "properties": {
        "initialStopped": { "type": "boolean" },
        "maxActionsPerSecond": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "applications": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "capabilities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "type": "string", "enum": ["aumid", "win32-file-identity"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 65535 }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "observe_window": { "$ref": "#/$defs/decision" },
              "observe_monitor": { "$ref": "#/$defs/decision" },
              "observe_desktop": { "$ref": "#/$defs/decision" },
              "pointer": { "$ref": "#/$defs/decision" },
              "keyboard": { "$ref": "#/$defs/decision" },
              "window_management": { "$ref": "#/$defs/decision" },
              "uia_read": { "$ref": "#/$defs/decision" },
              "uia_mutation": { "$ref": "#/$defs/decision" },
              "application_launch": { "$ref": "#/$defs/decision" },
              "application_activate": { "$ref": "#/$defs/decision" },
              "application_close": { "$ref": "#/$defs/decision" }
            }
          }
        }
      }
    },
    "security": { "$ref": "policy.v1.schema.json#/properties/security" },
    "logging": { "$ref": "policy.v1.schema.json#/properties/logging" },
    "emergencyStop": { "$ref": "policy.v1.schema.json#/properties/emergencyStop" }
  },
  "$defs": {
    "decision": { "type": "string", "enum": ["DENY", "ASK", "ALLOW"] }
  }
}
